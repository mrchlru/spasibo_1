<?xml version="1.0" encoding="utf-8"?>
<!-- Декоративный фон splash: тёмно-зелёный + абстрактные элементы как у логотипа. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/logo_background" />
        </shape>
    </item>

    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="top|start"
        android:left="24dp"
        android:top="72dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#332D5016" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="bottom|end"
        android:bottom="96dp"
        android:right="-40dp">
        <shape android:shape="oval">
            <stroke
                android:width="2.5dp"
                android:color="#282D5016" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center"
        android:top="40dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#1AFFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
