<?xml version="1.0" encoding="utf-8"?>
<!--
  Timeweb App Platform: стендовые URL *.twc1.net подписаны платформенным
  wildcard-сертификатом GlobalSign R46 2025. Старый WebView на Android 12
  не содержит этот CA в system store — добавляем явное доверие для наших хостов.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">twc1.net</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/globalsign_gcc_r46_dv_tls_ca_2025" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">twcstorage.ru</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">postimg.cc</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
